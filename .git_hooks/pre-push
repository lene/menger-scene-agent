#!/bin/sh
# Pre-push hook, the same in every enrolled repo (vendored from menger-toplevel
# shared/standards/hooks/pre-push by `./bootstrap.sh sync`; toplevel#79: the copies had
# diverged -- hard-coded origin/main, different stdin handling, and in menger a bypass that
# pushed a `WIP:` commit despite a failing gate, dropped by user decision 2026-10-16).
#
# Its only job: compute CHANGED_FILES / QA_RANGES / QA_REMOTE and hand them to
# standards/scripts/qa-runner.sh, which reads ./qa-manifest.yaml, decides which suites are
# relevant at push tier and runs them; each suite reports PASS/FAIL/SKIP. A failing gate blocks
# the push; an intentionally broken push is `git push --no-verify`, visibly.
#
# Change detection reads git's pre-push protocol from stdin. Run by hand (no stdin) it
# compares against main instead; see standards/hooks/lib.sh for the three invocation contexts.
set -u

if [ ! -r ./standards/hooks/lib.sh ]; then
  echo "pre-push: standards/hooks/lib.sh missing -- run ./bootstrap.sh sync in menger-toplevel" >&2
  exit 1
fi
. ./standards/hooks/lib.sh

retry_with_backoff "git fetch origin" git fetch origin --quiet || true
RANGES=$(push_ranges); _rc=$?
[ "$_rc" -eq 2 ] && exit 0   # the push only deletes a branch
# unquoted on purpose: split the newline-separated ranges into arguments
CHANGED_FILES=$(changed_files $RANGES)
assert_detection "$CHANGED_FILES" || exit 1

export CHANGED_FILES
export QA_RANGES="$RANGES"
export QA_REMOTE="${1:-origin}"

exec ./standards/scripts/qa-runner.sh --tier push
